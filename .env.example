PORT=
# REQUIRED. Which deployment this is: moosii | financial. No default — boot exits if
# unset or unknown. Exposed to the CMS as `domain` on GET /version.
DOMAIN=moosii
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
INTERNAL_API_KEY=
# REQUIRED when DOMAIN=financial, ignored otherwise. Bearer key for POST /facts ONLY (the partner
# intake) — must differ from INTERNAL_API_KEY and be at least 32 chars: openssl rand -hex 32
FACTS_API_KEY=
PROMPT_WRITER=
IMAGE_GENERATOR=
# Provider for generate_questionnaire (openai | gemini). Defaults to openai.
QUESTIONNAIRE_WRITER=
# Provider for POST /classify-update (openai | gemini). Defaults to openai.
CLASSIFY_WRITER=
# Ops only (scripts/curl from a laptop) — never read by the running server. Each Render service has
# its own INTERNAL_API_KEY; this holds the FINANCIAL service's value so a local script can call
# https://moosii-financial-backend.onrender.com/jobs.
FINANCIAL_INTERNAL_API_KEY=
# Comma-separated list of browser origins allowed via CORS.
# e.g. http://localhost:5173,https://moosii-cms.onrender.com
# Defaults to http://localhost:5173 if unset. (CORS_ALLOWED_ORIGINS is a legacy alias.)
ALLOWED_ORIGINS=
# MX Platform API (financial only; read by the derive_facts job when it runs, not at boot).
# Sandbox = https://int-api.mx.com (the default). Never commit real values.
MX_CLIENT_ID=
MX_API_KEY=
MX_BASE_URL=
# Demo persona sign-in (POST /demo/session, financial only). Unset → the route answers 503.
# The financial reader's origin (https://moosii-user-financial.onrender.com) must also be in ALLOWED_ORIGINS.
DEMO_ACCESS_CODE=
